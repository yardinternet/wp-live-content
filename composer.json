{
	"name": "yard/wp-live-content",
	"type": "package",
	"description": "Notify visitors via htmx polling when the post content has changed.",
	"license": "MIT",
	"support": {
		"source": "https://github.com/yardinternet/wp-live-content",
		"issues": "https://github.com/yardinternet/wp-live-content/issues"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true
		},
		"platform": {
			"php": "8.2"
		},
		"audit": {
			"ignore": {
				"PKSA-mdq4-51ck-6kdq": "CRLF injection in default email rule (CVE-2026-48019); no fix for EOL Laravel 10, which this package requires until the Acorn 5 upgrade.",
				"PKSA-3r5d-mb8f-1qw9": "Duplicate of CVE-2026-48019 via the FriendsOfPHP advisory database.",
				"PKSA-m5cs-t1y6-qpcs": "Temporary signed URL path confusion; no fix for EOL Laravel 10, which this package requires until the Acorn 5 upgrade."
			}
		}
	},
	"require": {
		"php": ">=8.2",
		"roots/acorn": "^4.3",
		"spatie/laravel-package-tools": "^1.16",
		"webmozart/assert": "^1.11",
		"yard/wp-hook-registrar": "^2.0"
	},
	"require-dev": {
		"10up/wp_mock": "^0.4.2",
		"larastan/larastan": "^2.9",
		"orchestra/testbench": "^8.27",
		"pestphp/pest": "^2.36",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"yard/php-cs-fixer-rules": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"Yard\\LiveContent\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Yard\\LiveContent\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"post-autoload-dump": [
			"sed -i -e 's#function __(#function ____(#' ./vendor/php-stubs/wordpress-stubs/wordpress-stubs.php"
		],
		"all": [
			"@test",
			"@analyse",
			"@format"
		],
		"analyse": "vendor/bin/phpstan analyse --debug --memory-limit 1G",
		"format": "vendor/bin/php-cs-fixer fix",
		"test": "vendor/bin/pest",
		"test:coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage"
	},
	"extra": {
		"acorn": {
			"providers": [
				"Yard\\LiveContent\\LiveContentServiceProvider"
			]
		}
	}
}
